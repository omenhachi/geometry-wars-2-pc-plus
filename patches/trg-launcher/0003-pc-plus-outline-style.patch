+// A neon outline: a wide faint glow under a crisp line, and a second line inset when it marks the selection.
+void NeonRect(ImDrawList* dl, ImVec2 a, ImVec2 b, ImU32 color, float s, bool double_line, float glow = 1.0f) {
+  const ImVec4 c = ImGui::ColorConvertU32ToFloat4(color);
+  dl->AddRect(a, b, ImGui::ColorConvertFloat4ToU32(ImVec4(c.x, c.y, c.z, c.w * 0.22f * glow)), 0, 0, 6 * s);
+  dl->AddRect(a, b, color, 0, 0, 1.6f * s);
+  if (double_line) {
+    const float in = 4 * s;
+    dl->AddRect(ImVec2(a.x + in, a.y + in), ImVec2(b.x - in, b.y - in), color, 0, 0, 1.6f * s);
+  }
+}
+
+// Capitals with extra spacing between letters, like the game's menus. Returns the width.
+float SpacedCapsWidth(ImFont* font, float size, const char* text, float spacing) {
+  float w = 0;
+  for (const char* p = text; *p; ++p) {
+    const char ch = char(std::toupper(static_cast<unsigned char>(*p)));
+    w += font->CalcTextSizeA(size, FLT_MAX, 0, &ch, &ch + 1).x + (p[1] ? spacing : 0);
+  }
+  return w;
+}
+
+float SpacedCaps(ImDrawList* dl, ImFont* font, float size, ImVec2 pos, ImU32 color, const char* text, float spacing) {
+  float x = pos.x;
+  for (const char* p = text; *p; ++p) {
+    const char ch = char(std::toupper(static_cast<unsigned char>(*p)));
+    dl->AddText(font, size, ImVec2(x, pos.y), color, &ch, &ch + 1);
+    x += font->CalcTextSizeA(size, FLT_MAX, 0, &ch, &ch + 1).x + spacing;
+  }
+  return x - pos.x;
+}
+
+void CornerBrackets(ImDrawList* dl, ImVec2 a, ImVec2 b, ImU32 color, float len, float thickness) {
+  dl->AddLine(a, ImVec2(a.x + len, a.y), color, thickness);
+  dl->AddLine(a, ImVec2(a.x, a.y + len), color, thickness);
+  dl->AddLine(ImVec2(b.x, a.y), ImVec2(b.x - len, a.y), color, thickness);
+  dl->AddLine(ImVec2(b.x, a.y), ImVec2(b.x, a.y + len), color, thickness);
+  dl->AddLine(ImVec2(a.x, b.y), ImVec2(a.x + len, b.y), color, thickness);
+  dl->AddLine(ImVec2(a.x, b.y), ImVec2(a.x, b.y - len), color, thickness);
+  dl->AddLine(b, ImVec2(b.x - len, b.y), color, thickness);
+  dl->AddLine(b, ImVec2(b.x, b.y - len), color, thickness);
+}
+
+// The faint grid the game draws inside its cards.
+void PanelGrid(ImDrawList* dl, ImVec2 a, ImVec2 b, ImU32 color, float step) {
+  for (float x = a.x + step; x < b.x; x += step) dl->AddLine(ImVec2(x, a.y), ImVec2(x, b.y), color, 1.0f);
+  for (float y = a.y + step; y < b.y; y += step) dl->AddLine(ImVec2(a.x, y), ImVec2(b.x, y), color, 1.0f);
+}
+
+// A framed panel: grid, violet outline and corner brackets.
+void FramePanel(ImDrawList* dl, ImVec2 a, ImVec2 b, const Theme& t, float s) {
+  PanelGrid(dl, a, b, Col(t.line, 0.07f), 32 * s);
+  NeonRect(dl, a, b, Col(t.line), s, false, 0.6f);
+  CornerBrackets(dl, ImVec2(a.x - 3 * s, a.y - 3 * s), ImVec2(b.x + 3 * s, b.y + 3 * s), Col(t.accent, 0.9f),
+                 16 * s, 2.0f * s);
 }
 
